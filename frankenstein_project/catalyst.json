{
  "appsail": [
    {
      "source": "docker://merged-labelkit:latest",
      "name": "merged-labelkit",
      "port": 9000,
      "memory": 2048,
      "env_variables": {
        "PYTHONUNBUFFERED": "1",
        "KEHE_PRODUCT_MASTER_STORE": "auto",
        "KEHE_PRODUCT_MASTER_TABLE": "kehe_product_master",
        "KEHE_DC_DIRECTORY_STORE": "auto",
        "KEHE_DC_DIRECTORY_TABLE": "kehe_dc_directory",
        "KEHE_MPL_DRAFTS_STORE": "auto",
        "KEHE_MPL_DRAFTS_TABLE": "kehe_mpl_drafts",
        "KEHE_AUDIT_LOG_STORE": "auto",
        "KEHE_AUDIT_LOG_TABLE": "kehe_audit_log"
      }
    }
  ]
}
